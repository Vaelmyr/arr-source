datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model Download {
  id         String  @id
  providerId String
  itemId     String
  title      String
  category   String?

  priority Int            @default(-100)
  status   DownloadStatus

  totalBytes      BigInt?
  downloadedBytes BigInt  @default(0)

  outputPath String?
  tempPath   String?
  error      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?
}

enum DownloadStatus {
  QUEUED
  DOWNLOADING
  PAUSED
  COMPLETED
  FAILED
}
